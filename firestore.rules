rules_version = '2';

// O app não acessa o Firestore diretamente: os dados passam pela API, que
// valida o Firebase ID Token e as permissões de cada perfil. A API usa a
// conta de serviço (que ignora estas regras); qualquer acesso de cliente é negado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
