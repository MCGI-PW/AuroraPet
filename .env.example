# Opcional: o app.config.js já traz a configuração de produção.
# Use estas variáveis apenas para apontar para outro ambiente.

# URL da API (ex.: API local)
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Firebase (configuração pública do app Web do projeto)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Desenvolvimento/testes com o Firebase Auth Emulator
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
